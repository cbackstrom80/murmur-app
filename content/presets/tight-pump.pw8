  "metadata": {
    "id": "pw8-tight-pump",
    "name": "TIGHT PUMP",
    "author": "Patchwork Eight Engineering",
    "description": "Super-aggressive tempo-synced arp built to pump: detuned saw + sub + octave shimmer through a resonant lowpass, staccato 1/16 Up-Down pattern with downbeat accents and ratchet bursts, sidechain-ducking tape delay, saturated insert, and a fast master compressor/limiter chain for in-your-face groove energy. Hold a minor triad (e.g. A2-C3-E3) and latch keeps it cycling.",
    "category": "seq",
    "moods": [
      "aggressive",
      "pumping",
      "tight",
      "energetic"
    ],
    "genres": [
      "techno",
      "house",
      "trance"
    ],
    "tags": [
