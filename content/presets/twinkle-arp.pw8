{
  "schemaVersion": 2,
  "metadata": {
    "id": "pw8-twinkle-arp",
    "name": "TWINKLE ARP",
    "author": "Patchwork Eight Engineering",
    "description": "A bright, sparkly, bell-adjacent pluck for arpeggiated lines -- built for the moving-chord-progression ambient pieces alongside a pad and a bass part. Sine fundamental + octave triangle + a deliberately-detuned 3rd-harmonic sine (ratio 3.005, inharmonic on purpose -- the bell/glockenspiel color) + a quiet 4th-octave triangle shimmer on top. A fast decay with a near-zero sustain (0.05) keeps each note a distinct articulate 'ting' rather than a sustained tone, so a run of arpeggio notes stays readable instead of smearing into a pad. Chorus for width, a dotted-feeling Tape Delay (375ms, ping-pong) for the actual 'twinkling' repeats, and a bright-leaning Reverb (high-ratio 0.85) so the tail carries the sparkle rather than darkening it. A gentle 0.3Hz LFO1 -> Filter Cutoff keeps the brightness slowly breathing rather than static.",
    "category": "arp",
    "moods": [
      "bright",
      "sparkly",
      "bell",
      "twinkling"
    ],
    "genres": [
      "ambient",
      "score"
    ],
    "tags": [
      "arp",
      "bell",
      "delay-showcase",
      "high-register"
    ],
