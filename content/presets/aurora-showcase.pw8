{
  "schemaVersion": 1,
  "metadata": {
    "id": "pw8-aurora-showcase",
    "name": "AURORA SHOWCASE",
    "author": "Patchwork Eight Engineering",
    "description": "Demonstration patch built for brightness: an Additive operator with positive spectral tilt and mostly-odd harmonics for a rich, glassy body, two FM/PM operators at high modulator ratios (4.01, 7.03) for bell/glass overtone shimmer, a PhaseShape operator with strong bend+fold for slow harmonic movement, a morphing Wavetable pad from the metallic-glass-shimmer table, a sparse Granular operator reading the bell-glass-chime table for random chime hits, and a Blue-noise NoiseChaos sparkle bed. LFO1 breathes the filter; LFO2 slowly morphs the Wavetable operator's frame position for continuous timbral drift.",
    "category": "pad",
    "moods": [
      "bright",
      "shimmering",
      "dreamy",
      "showcase"
    ],
    "genres": [
      "ambient",
      "score"
    ],
    "tags": [
      "additive",
      "fm",
      "demo"
    ],
    "createdAt": "2026-08-11T00:00:00Z",
    "engineVersion": "0.1.0",
