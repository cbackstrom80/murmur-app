{
  "schemaVersion": 1,
  "metadata": {
    "id": "pw8-tide-showcase",
    "name": "TIDE SHOWCASE",
    "author": "Patchwork Eight Engineering",
    "description": "Demonstration patch emphasizing Patchwork Eight's newer generative/textural engines: two Resonator operators (root and a detuned 5th, different structure/damping settings) for a bowed modal pad body, two Granular operators reading different wavetables at different densities/jitter for a drifting grain-cloud texture, a Brown-noise NoiseChaos bed for air, a subtle PhaseShape fold for edge, and a Wavetable fifth-stack for harmonic anchor. LFO1 breathes Filter1 cutoff; LFO2 slowly drifts both Granular operators' read positions in opposite phase for an oceanic, non-repeating motion.",
    "category": "pad",
    "moods": [
      "oceanic",
      "organic",
      "drifting",
      "showcase"
    ],
    "genres": [
      "ambient",
      "score"
    ],
    "tags": [
      "granular",
      "resonator",
      "demo"
    ],
