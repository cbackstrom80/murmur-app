{
  "schemaVersion": 1,
  "metadata": {
    "id": "pw8-bloom-showcase",
    "name": "BLOOM SHOWCASE",
    "author": "Patchwork Eight Engineering",
    "description": "Demonstration patch: one of Patchwork Eight's 8 operators is assigned to each of the 8 engine types (Classic sub, Wavetable pad, FM/PM bell shimmer, Additive harmonic body, PhaseShape motion, Granular texture cloud, NoiseChaos air, Resonator modal pad), summed in parallel into one evolving cinematic chord pad. LFO1 sweeps Filter1 cutoff very slowly; LFO2 sweeps the Granular operator's wavetable read position for a slowly drifting grain cloud. Built to show off every engine at once, not for surgical mix control.",
    "category": "pad",
    "moods": [
      "cinematic",
      "warm",
      "evolving",
      "showcase"
    ],
    "genres": [
      "ambient",
      "score"
    ],
    "tags": [
      "all-engines",
      "demo",
      "reverb-showcase"
    ],
    "createdAt": "2026-08-11T00:00:00Z",
