{
  "schemaVersion": 1,
  "metadata": {
    "id": "pw8-fx-freq-echo",
    "name": "FX FREQ ECHO",
    "author": "Patchwork Eight Engineering",
    "description": "A plain sine pluck through FreqShiftEcho, informed by ValhallaFreqEcho's research (docs/FX_BANK.md): a single-sideband frequency shifter sits INSIDE the delay's feedback loop, so each repeat's frequency content shifts a further +18Hz. A held note's harmonics drift progressively out of tune across the echoes rather than repeating identically -- the psychedelic, sci-fi-transition character the research called out, built from this project's own from-scratch FIR Hilbert transformer (dsp::FrequencyShifter) rather than any vendored code.",
    "category": "fx",
    "moods": [
      "psychedelic",
      "otherworldly",
      "evolving"
    ],
    "genres": [],
    "tags": [
