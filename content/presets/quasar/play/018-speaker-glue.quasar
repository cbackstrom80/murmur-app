{
  "schemaVersion": 1,
  "metadata": {
    "name": "SPEAKER GLUE",
    "author": "MURMUR Sound Design",
    "description": "Speaker output mode with crossfeed \u2014 safer on loudspeakers, still spatial on cans.",
