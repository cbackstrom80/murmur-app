    "cntrLevel": 0.82,
    "inputSplitHpfHz": 120.0,
    "cntrHpfHz": 80.0,
    "qsr1Height": 0.0,
    "qsr1Angle": 48.0,
    "qsr1Distance": 0.38,
    "qsr2Height": 0.0,
    "qsr2Angle": 312.0,
    "qsr2Distance": 0.42,
    "qsr1RoomAmount": 0.38,
    "qsr1RoomSize": 1.05,
    "qsr1RoomDamping": 0.52,
    "qsr2RoomAmount": 0.34,
    "qsr2RoomSize": 1.12,
