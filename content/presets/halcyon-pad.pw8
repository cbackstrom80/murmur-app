{
  "schemaVersion": 1,
  "metadata": {
    "id": "pw8-halcyon-pad",
    "name": "HALCYON PAD",
    "author": "Patchwork Eight Engineering",
    "description": "A warm, gorgeous, slow-swelling major-key pad. WARM via a mostly-triangle/sine upper stack over a hand-detuned saw trio (ratios 0.997/1.0/1.003, the same fake-unison technique wide-saw.pw8/gate4 established) plus a centered sub sine an octave down. LUSH via a Chorus insert (rate 0.35Hz, depth 6ms) ahead of a gentle Saturation (4dB) for body without edge. GORGEOUS via a big, natural-leaning Reverb (size 2.0, decay 5.5s, high-ratio 0.75 so the tail stays bright rather than dark like the Dune session's reverbs) and a +2dB high-shelf-ish EQ lift for air. EVOLVING via a slow LFO1 -> FilterCutoff breathe and a light Velocity -> FilterCutoff touch response. Filter 1 sits open (2200Hz, low resonance) so full extended chords (maj9, add9, m9) stay clear rather than muddy.",
    "category": "pad",
    "moods": [
      "warm",
      "gorgeous",
      "inspiring",
      "lush",
      "evolving"
    ],
    "genres": [
      "ambient",
      "score",
      "worship"
    ],
    "tags": [
      "pad",
      "chorus",
      "reverb-showcase",
      "major-key"
    ],
    "createdAt": "2026-08-10T00:00:00Z",
    "engineVersion": "0.1.0",
    "schemaVersion": 1,
    "seed": 4201,
