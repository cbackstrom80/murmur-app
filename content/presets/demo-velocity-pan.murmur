{
  "schemaVersion": 2,
  "metadata": {
    "id": "murmur-demo-velocity-pan",
    "name": "DEMO: VELOCITY PAN",
    "author": "Patchwork Eight Engineering",
    "description": "Modulation demo: Velocity -> Pan. Pan modulation is additive against the layer's base pan (panOffset += sourceValue * amount, ModMatrixExecutor.hpp), and velocity is unipolar (0..1) -- so a hard-left base pan (-0.9) plus amount 1.8 gives a genuine soft-hit-left / hard-hit-right sweep: at velocity 0 the offset is 0 (stays at -0.9), at velocity 127 the offset is +1.8 (lands at +0.9). Six identical plucks at rising velocity (20, 40, 60, 80, 100, 127) should audibly walk left to right across the stereo field.",
    "category": "pluck",
    "moods": [
      "modulation-demo",
      "stereo",
      "dynamic"
    ],
    "genres": [
      "demo"
    ],
